# ========================================
# VELORA — Environment Configuration
# Copy this file to .env.local and update with your values
# ========================================

# ===== GENERAL =====
NODE_ENV=development
LOG_LEVEL=debug

# ===== FRONTEND (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VELORA
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,fr,ar

# ===== BACKEND (NestJS) =====
API_PORT=3001
API_HOST=localhost

# ===== DATABASE (PostgreSQL) =====
DATABASE_URL=postgresql://velora:velora@localhost:5432/velora_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ===== REDIS (Cache) =====
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ===== AUTHENTICATION =====
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d
SESSION_SECRET=your-session-secret-change-in-production

# ===== STORAGE (S3/Cloudflare R2) =====
STORAGE_TYPE=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=velora
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ===== SECURITY =====
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== EXTERNAL SERVICES (Future Phases) =====
# SENTRY_DSN=
# ANALYTICS_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
